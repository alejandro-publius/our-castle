{
  "name": "our-house",
  "version": "0.2.0",
  "private": true,
  "description": "Our House: a cooperative household savings board journey with an adult-approved PayPal sandbox checkout and an AI milestone planner",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "art-preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run check && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "reset-demo": "node scripts/reset-demo.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@paypal/agent-toolkit": "1.11.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "ag-grid-community": "36.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
