# Copy to .env (server-side only, never committed) and fill in. Missing values select
# clearly labeled example modes; nothing falls back to any other credential.

# PayPal developer sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox).
# Only "sandbox" is accepted; this prototype has no path to live endpoints.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the same sandbox app, for verified capture/refund webhooks.
PAYPAL_WEBHOOK_ID=

# Optional read-only PYUSD Solana devnet watcher. Default off; only "devnet" enables its fixed read-only endpoint.
# An adult then enrolls a fund's public address. No key, mainnet endpoint or outgoing wallet transaction is accepted.
OUR_CASTLE_VAULT=off
# Optional platform-only subscription agreement tracking, disabled by default. This does not import recurring charges.
# Requires PayPal platform eligibility and seller onboarding, not merely a checkout account. See docs/VILLAGE-TREASURER.md.
OUR_CASTLE_SUBSCRIPTIONS=off
PAYPAL_SUBSCRIPTIONS_SELLER_ONBOARDED=false
PAYPAL_SUBSCRIPTIONS_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_SUBSCRIPTIONS_PRODUCT_ID=

# Runtime AI planner. Use an application API key from the provider's console.
# A coding assistant's login/OAuth session is not an application key and is never read.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_API_KEY=

# Market Town merchant: Channel3 product search (https://channel3.ai/docs). Server-side only, never in browser code.
# Create a developer account at https://trychannel3.com/sign-up/developer, then copy a key from
# https://trychannel3.com/dashboard/api. Empty leaves the merchant "not connected"; nothing is faked.
CHANNEL3_API_KEY=

# Kit list photos: optional. An adult can type a kit list without this. With a key of its OWN, an adult can also ask
# OpenAI's Responses API to read a photo of a written list into a draft they check before saving. OPENAI_API_KEY and
# AI_API_KEY are never used for this. Empty leaves photo reading off; nothing is faked. Default model: gpt-6-sol.
KIT_OPENAI_API_KEY=
KIT_OPENAI_MODEL=

# Kit comparison: optional ordering of kits that already fit by a preference the family picks ("Lighter to carry"...),
# with Cohere Rerank. Uses a key of its OWN; CO_API_KEY/COHERE_API_KEY are never read. Only public catalog titles and a
# fixed preference sentence are sent. Empty leaves it off; every comparison still works. Default model: rerank-v5.0-fast.
KIT_COHERE_API_KEY=
KIT_COHERE_MODEL=
# The complete-kit solver: auto (default: the Rust build from solver/ when present, else the built-in reference),
# native (refuse to start without the Rust build) or reference.
OUR_CASTLE_KIT_SOLVER=

# Treasury: optional AG Studio browser licence. The supplied trial permits local evaluation only.
# Quote the entire value if it contains spaces. No provider API key is exposed to the browser.
AG_STUDIO_LICENSE_KEY=

PORT=3010
